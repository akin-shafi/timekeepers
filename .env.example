# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db?schema=public"

# NextAuth / Auth.js Config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="attendance_app_super_secret_jwt_key_2026"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Default Tenant Configuration
DEFAULT_ALLOWED_DOMAIN="getrova.com"

# SMTP Configuration (Gmail)

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM="\"Time Keeper\" <noreply.yourdomain@gmail.com>"

# Google Maps API Key for Geocoding / Address lookup
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Admin Credentials
ADMIN_EMAIL="admin@email.com"
ADMIN_PASSWORD="your-secure-admin-password"

# HR Dummy Credentials
DUMMY_HR_EMAIL="hr.admin@getrova.com"
DUMMY_HR_PASSWORD="admin123"

# AI Configuration
GEMINI_API_KEY="your-gemini-api-key"

AWS_SECRETS_REGION="us-east-1"
AWS_SECRETS_NAME="attendance-app-production-secrets"

